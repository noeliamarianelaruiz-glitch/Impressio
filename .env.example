# Supabase PostgreSQL
# Create a project at https://supabase.com, then obtain the connection string
# from Dashboard → Project Settings → Database → Connection string.
# Use the "Direct connection" (or "Pooler" for production) URL format below.
# Append `?sslmode=require` at the end when using Supabase.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@db.[project-ref].supabase.co:5432/postgres?sslmode=require&directconnection=true"

# Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-long-random-string"

# GitHub OAuth
GITHUB_ID=""
GITHUB_SECRET=""

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Email provider (optional, for email sign-in)
EMAIL_SERVER_HOST=""
EMAIL_SERVER_PORT=""
EMAIL_SERVER_USER=""
EMAIL_SERVER_PASSWORD=""
EMAIL_FROM=""
