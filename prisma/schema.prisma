generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ──────────────────────────────────────────────
// Enums — normalized, no duplicates, consistent naming
// ──────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  ADMIN
  MANAGER
  CLIENT
  VENDOR
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PRODUCTION
  PRINTING
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductionStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  QC_CHECK
  COMPLETED
  DELAYED
}

enum PaymentMethod {
  CASH
  TRANSFER
  CARD
  STRIPE
  MERCADOPAGO
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  PARTIAL
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED
  CANCELLED
}

enum InventoryMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  RETURN
  CONSUMPTION
}

enum PurchaseOrderStatus {
  DRAFT
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

enum AddressType {
  SHIPPING
  BILLING
  COMPANY
  BRANCH
  BOTH
}

enum NotificationType {
  ORDER_UPDATE
  PAYMENT_RECEIVED
  BUDGET_EXPIRED
  SYSTEM
  AI_SUMMARY
  INVENTORY_LOW
  PRODUCTION_DELAY
}

enum FileType {
  IMAGE
  DOCUMENT
  DESIGN
  ARCHIVE
  OTHER
}

// ──────────────────────────────────────────────
// Auth.js models (required by @auth/prisma-adapter, prisma v7 compatible)
// ──────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique(map: "User_email_unique")
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(CLIENT)
  companyId     String?
  phone         String?
  lastLoginAt   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts           Account[]
  sessions           Session[]
  ownedCompanies     Company[]           @relation("CompanyOwner")
  memberCompanies    Company[]           @relation("CompanyMember")
  createdOrders      Order[]             @relation("OrderCreator")
  assignedOrders     Order[]             @relation("OrderAssignee")
  createdQuotes      Quote[]             @relation("QuoteCreator")
  approvedQuotes     Quote[]             @relation("QuoteApprover")
  createdInvoices    Invoice[]           @relation("InvoiceCreator")
  productionJobs     ProductionJob[]
  notifications      Notification[]
  auditLogs          AuditLog[]          @relation("AuditActor")
  uploadedFiles      UploadedFile[]
  inventoryMovements InventoryMovement[]
  purchaseOrders     PurchaseOrder[]
  customers          Customer[]
  managedBranches    Branch[]            @relation("BranchManager")

  // ── Optimization indexes ──
  @@index([companyId, role], map: "idx_User_company_role")
  @@map("User")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "idx_Account_userId")
  @@map("Account")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique(map: "Session_sessionToken_unique")
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_Session_userId")
  @@index([expires], map: "idx_Session_expires")
  @@map("Session")
}

model VerificationToken {
  identifier String
  token      String   @unique(map: "VerificationToken_token_unique")
  expires    DateTime

  @@unique([identifier, token], map: "uq_VerificationToken_identifier_token")
  @@index([expires], map: "idx_VerificationToken_expires")
  @@map("VerificationToken")
}

// ──────────────────────────────────────────────
// RBAC — Role-Permission join table
// ──────────────────────────────────────────────

model RolePermission {
  role         UserRole
  permissionId String

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([role, permissionId])
  @@map("RolePermission")
}

model Permission {
  id          String   @id @default(cuid())
  name        String
  resource    String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]

  @@unique([resource, action], map: "uq_Permission_resource_action")
  @@map("Permission")
}

// ──────────────────────────────────────────────
// Tenant & Identity
// ──────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  slug      String
  logo      String?
  taxId     String?
  phone     String?
  website   String?
  currency  String   @default("ARS")
  timezone  String   @default("America/Argentina/Buenos_Aires")
  language  String   @default("es")
  settings  Json     @default("{}")
  plan      String   @default("free")
  isActive  Boolean  @default(true)
  ownerId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner              User                @relation("CompanyOwner", fields: [ownerId], references: [id])
  users              User[]              @relation("CompanyMember")
  branches           Branch[]
  customers          Customer[]
  products           Product[]
  categories         Category[]
  quotes             Quote[]
  orders             Order[]
  invoices           Invoice[]
  payments           Payment[]
  shipments          Shipment[]
  purchaseOrders     PurchaseOrder[]
  suppliers          Supplier[]
  inventories        Inventory[]
  companySettings    CompanySetting[]
  companyAddresses   CompanyAddress[]
  auditLogs          AuditLog[]
  materials          Material[]
  printingTechniques PrintingTechnique[]
  productionJobs     ProductionJob[]
  uploadedFiles      UploadedFile[]

  @@unique([slug], map: "uq_Company_slug")
  @@index([ownerId], map: "idx_Company_ownerId")
  @@index([plan], map: "idx_Company_plan")
  @@index([settings], type: Gin, map: "idx_Company_settings_gin")
  @@map("Company")
}

// ──────────────────────────────────────────────
// Branch (Sucursal)
// ──────────────────────────────────────────────

model Branch {
  id        String   @id @default(cuid())
  companyId String
  name      String
  address   String?
  phone     String?
  managerId String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager        User?           @relation("BranchManager", fields: [managerId], references: [id])
  orders         Order[]
  productionJobs ProductionJob[]
  inventories    Inventory[]

  @@index([companyId, name], map: "idx_Branch_company_name")
  @@index([managerId], map: "idx_Branch_managerId")
  @@map("Branch")
}

// ──────────────────────────────────────────────
// CRM — Customer
// ──────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  companyId  String
  userId     String?
  name       String
  email      String?
  phone      String?
  documentId String?
  notes      String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  company           Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user              User?             @relation(fields: [userId], references: [id])
  customerAddresses CustomerAddress[]
  quotes            Quote[]
  orders            Order[]
  invoices          Invoice[]
  payments          Payment[]

  @@index([companyId, email], map: "idx_Customer_company_email")
  @@index([companyId, documentId], map: "idx_Customer_company_documentId")
  @@index([userId], map: "idx_Customer_userId")
  @@map("Customer")
}

// ──────────────────────────────────────────────
// Addresses — shared by Customer, Company, Shipment, Invoice
// ──────────────────────────────────────────────

model Address {
  id         String   @id @default(cuid())
  line1      String
  line2      String?
  city       String
  state      String?
  postalCode String?
  country    String   @default("AR")
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  customerAddresses CustomerAddress[]
  companyAddresses  CompanyAddress[]
  shipments         Shipment[]        @relation("ShipmentAddress")
  billingInvoices   Invoice[]         @relation("InvoiceBillingAddress")

  @@map("Address")
}

model CustomerAddress {
  customerId String
  addressId  String
  type       AddressType @default(SHIPPING)
  isDefault  Boolean     @default(false)

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  address  Address  @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@id([customerId, addressId])
  @@map("CustomerAddress")
}

model CompanyAddress {
  companyId String
  addressId String
  type      AddressType @default(COMPANY)

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  address Address @relation(fields: [addressId], references: [id], onDelete: Cascade)

  @@id([companyId, addressId])
  @@map("CompanyAddress")
}

// ──────────────────────────────────────────────
// Catalog — Categories, Products, Variants
// ──────────────────────────────────────────────

model Category {
  id          String   @id @default(cuid())
  companyId   String?
  parentId    String?
  name        String
  slug        String
  description String?
  icon        String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company?   @relation(fields: [companyId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@unique([companyId, slug], map: "uq_Category_company_slug")
  @@index([parentId], map: "idx_Category_parentId")
  @@map("Category")
}

model Product {
  id               String   @id @default(cuid())
  companyId        String
  categoryId       String?
  name             String
  slug             String
  description      String?
  basePrice        Decimal  @default(0)
  currency         String   @default("ARS")
  unit             String   @default("units")
  minOrderQuantity Int      @default(1)
  images           String[] @default([])
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company       Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      Category?        @relation(fields: [categoryId], references: [id])
  variants      ProductVariant[]
  orderItems    OrderItem[]
  quoteItems    QuoteItem[]
  uploadedFiles UploadedFile[]

  @@unique([companyId, slug], map: "uq_Product_company_slug")
  @@index([companyId, isActive], map: "idx_Product_company_active")
  @@index([companyId, categoryId], map: "idx_Product_company_category")
  @@index([categoryId], map: "idx_Product_categoryId")
  @@map("Product")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  name       String
  sku        String?
  price      Decimal  @default(0)
  attributes Json     @default("{}")
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  product            Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems         OrderItem[]
  quoteItems         QuoteItem[]
  inventories        Inventory[]
  productionJobs     ProductionJob[]
  purchaseOrderItems PurchaseOrderItem[]
  printingTechniques PrintingTechnique[]

  @@unique([productId, sku], map: "uq_ProductVariant_product_sku")
  @@index([productId], map: "idx_ProductVariant_productId")
  @@index([attributes], type: Gin, map: "idx_ProductVariant_attributes_gin")
  @@map("ProductVariant")
}

// ──────────────────────────────────────────────
// Materials & Printing Techniques
// ──────────────────────────────────────────────

model Material {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  unit        String   @default("units")
  basePrice   Decimal  @default(0)
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  quoteItems         QuoteItem[]
  orderItems         OrderItem[]
  inventories        Inventory[]
  purchaseOrderItems PurchaseOrderItem[]
  productionJobs     ProductionJob[]

  @@index([companyId], map: "idx_Material_companyId")
  @@map("Material")
}

model PrintingTechnique {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  slug             String
  description      String?
  maxWidth         Decimal?
  maxHeight        Decimal?
  minOrderQuantity Int      @default(1)
  isActive         Boolean  @default(true)
  sortOrder        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variants       ProductVariant[]
  quoteItems     QuoteItem[]
  orderItems     OrderItem[]
  productionJobs ProductionJob[]

  @@unique([companyId, slug], map: "uq_PrintingTechnique_company_slug")
  @@map("PrintingTechnique")
}

// ──────────────────────────────────────────────
// Quotes → Orders
// ──────────────────────────────────────────────

model Quote {
  id           String      @id @default(cuid())
  slug         String
  companyId    String
  customerId   String
  status       QuoteStatus @default(DRAFT)
  subtotal     Decimal     @default(0)
  taxRate      Decimal?    @default(0)
  taxAmount    Decimal?    @default(0)
  totalAmount  Decimal     @default(0)
  currency     String      @default("ARS")
  validUntil   DateTime?
  notes        String?
  acceptedAt   DateTime?
  rejectedAt   DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  createdById  String?
  approvedById String?

  company  Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator  User?       @relation("QuoteCreator", fields: [createdById], references: [id])
  approver User?       @relation("QuoteApprover", fields: [approvedById], references: [id])
  items    QuoteItem[]
  order    Order?

  @@unique([companyId, slug], map: "uq_Quote_company_slug")
  @@index([companyId, status], map: "idx_Quote_company_status")
  @@index([companyId, customerId], map: "idx_Quote_company_customer")
  @@index([createdById], map: "idx_Quote_createdById")
  @@index([approvedById], map: "idx_Quote_approvedById")
  @@index([companyId, status, createdAt], map: "idx_Quote_company_status_created")
  @@map("Quote")
}

model QuoteItem {
  id            String  @id @default(cuid())
  quoteId       String
  productId     String
  variantId     String?
  materialId    String?
  techniqueId   String?
  quantity      Int     @default(1)
  unitPrice     Decimal
  totalPrice    Decimal
  customization Json?
  notes         String?
  sortOrder     Int     @default(0)

  quote     Quote              @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  product   Product?           @relation(fields: [productId], references: [id])
  variant   ProductVariant?    @relation(fields: [variantId], references: [id])
  material  Material?          @relation(fields: [materialId], references: [id])
  technique PrintingTechnique? @relation(fields: [techniqueId], references: [id])

  @@index([quoteId], map: "idx_QuoteItem_quoteId")
  @@index([productId], map: "idx_QuoteItem_productId")
  @@index([variantId], map: "idx_QuoteItem_variantId")
  @@index([materialId], map: "idx_QuoteItem_materialId")
  @@index([techniqueId], map: "idx_QuoteItem_techniqueId")
  @@index([customization], type: Gin, map: "idx_QuoteItem_customization_gin")
  @@map("QuoteItem")
}

model Order {
  id              String      @id @default(cuid())
  orderNumber     String
  companyId       String
  customerId      String
  userId          String
  quoteId         String?     @unique
  branchId        String?
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @default(0)
  taxRate         Decimal?    @default(0)
  taxAmount       Decimal?    @default(0)
  totalAmount     Decimal     @default(0)
  currency        String      @default("ARS")
  shippingAddress Json?
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  createdById     String?
  assignedToId    String?

  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer      Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creator       User?           @relation("OrderCreator", fields: [createdById], references: [id])
  assignee      User?           @relation("OrderAssignee", fields: [assignedToId], references: [id])
  quote         Quote?          @relation(fields: [quoteId], references: [id])
  branch        Branch?         @relation(fields: [branchId], references: [id])
  items         OrderItem[]
  payment       Payment?
  invoice       Invoice?
  shipment      Shipment?
  production    ProductionJob[]
  notifications Notification[]
  auditLogs     AuditLog[]      @relation("OrderAudit")

  @@unique([companyId, orderNumber], map: "uq_Order_company_number")
  @@index([companyId, status], map: "idx_Order_company_status")
  @@index([companyId, customerId], map: "idx_Order_company_customer")
  @@index([companyId, createdAt], map: "idx_Order_company_createdAt")
  @@index([companyId, branchId], map: "idx_Order_company_branch")
  @@index([userId], map: "idx_Order_userId")
  @@index([createdById], map: "idx_Order_createdById")
  @@index([assignedToId], map: "idx_Order_assignedToId")
  @@index([customerId], map: "idx_Order_customerId")
  @@index([branchId], map: "idx_Order_branchId")
  @@index([shippingAddress], type: Gin, map: "idx_Order_shippingAddress_gin")
  @@index([createdAt], map: "idx_Order_createdAt")
  @@map("Order")
}

model OrderItem {
  id            String  @id @default(cuid())
  orderId       String
  productId     String
  variantId     String?
  materialId    String?
  techniqueId   String?
  quantity      Int     @default(1)
  unitPrice     Decimal
  totalPrice    Decimal
  customization Json?
  notes         String?
  sortOrder     Int     @default(0)

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product?           @relation(fields: [productId], references: [id])
  variant   ProductVariant?    @relation(fields: [variantId], references: [id])
  material  Material?          @relation(fields: [materialId], references: [id])
  technique PrintingTechnique? @relation(fields: [techniqueId], references: [id])

  @@index([orderId], map: "idx_OrderItem_orderId")
  @@index([productId], map: "idx_OrderItem_productId")
  @@index([variantId], map: "idx_OrderItem_variantId")
  @@index([materialId], map: "idx_OrderItem_materialId")
  @@index([techniqueId], map: "idx_OrderItem_techniqueId")
  @@index([customization], type: Gin, map: "idx_OrderItem_customization_gin")
  @@map("OrderItem")
}

// ──────────────────────────────────────────────
// Production Jobs
// ──────────────────────────────────────────────

model ProductionJob {
  id             String           @id @default(cuid())
  orderId        String
  companyId      String
  branchId       String?
  variantId      String?
  materialId     String?
  techniqueId    String?
  status         ProductionStatus @default(PENDING)
  assignedToId   String?
  quantity       Int              @default(0)
  startedAt      DateTime?
  estimatedEndAt DateTime?
  completedAt    DateTime?
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  order     Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company   Company            @relation(fields: [companyId], references: [id])
  branch    Branch?            @relation(fields: [branchId], references: [id])
  assignee  User?              @relation(fields: [assignedToId], references: [id])
  variant   ProductVariant?    @relation(fields: [variantId], references: [id])
  material  Material?          @relation(fields: [materialId], references: [id])
  technique PrintingTechnique? @relation(fields: [techniqueId], references: [id])

  @@index([companyId, status], map: "idx_ProductionJob_company_status")
  @@index([orderId], map: "idx_ProductionJob_orderId")
  @@index([branchId], map: "idx_ProductionJob_branchId")
  @@index([variantId], map: "idx_ProductionJob_variantId")
  @@index([materialId], map: "idx_ProductionJob_materialId")
  @@index([techniqueId], map: "idx_ProductionJob_techniqueId")
  @@index([assignedToId], map: "idx_ProductionJob_assignedToId")
  @@index([assignedToId, status], map: "idx_ProductionJob_assignee_status")
  @@map("ProductionJob")
}

// ──────────────────────────────────────────────
// Inventory
// ──────────────────────────────────────────────

model Inventory {
  id               String   @id @default(cuid())
  companyId        String
  productVariantId String?
  materialId       String?
  branchId         String?
  quantity         Int      @default(0)
  reserved         Int      @default(0)
  minStock         Int      @default(0)
  location         String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  variant   ProductVariant?     @relation(fields: [productVariantId], references: [id], onDelete: SetNull)
  material  Material?           @relation(fields: [materialId], references: [id], onDelete: SetNull)
  branch    Branch?             @relation(fields: [branchId], references: [id], onDelete: SetNull)
  movements InventoryMovement[]

  @@unique([companyId, productVariantId], map: "uq_Inventory_company_variant")
  @@unique([companyId, materialId], map: "uq_Inventory_company_material")
  @@index([companyId, branchId], map: "idx_Inventory_company_branch")
  @@index([productVariantId], map: "idx_Inventory_productVariantId")
  @@index([materialId], map: "idx_Inventory_materialId")
  @@index([branchId], map: "idx_Inventory_branchId")
  @@map("Inventory")
}

model InventoryMovement {
  id            String                @id @default(cuid())
  inventoryId   String
  type          InventoryMovementType
  quantity      Int
  referenceId   String?
  referenceType String?
  notes         String?
  createdById   String?
  createdAt     DateTime              @default(now())

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  creator   User?     @relation(fields: [createdById], references: [id])

  @@index([inventoryId, createdAt], map: "idx_InventoryMovement_inventory_createdAt")
  @@index([createdById], map: "idx_InventoryMovement_createdById")
  @@map("InventoryMovement")
}

// ──────────────────────────────────────────────
// Purchases — Suppliers & Purchase Orders
// ──────────────────────────────────────────────

model Supplier {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  contactName  String?
  email        String?
  phone        String?
  documentId   String?
  paymentTerms String?
  isActive     Boolean  @default(true)
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company        Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  purchaseOrders PurchaseOrder[]

  @@index([companyId], map: "idx_Supplier_companyId")
  @@map("Supplier")
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  poNumber    String
  companyId   String
  supplierId  String
  status      PurchaseOrderStatus @default(DRAFT)
  subtotal    Decimal             @default(0)
  taxRate     Decimal?            @default(0)
  taxAmount   Decimal?            @default(0)
  totalAmount Decimal             @default(0)
  expectedAt  DateTime?
  receivedAt  DateTime?
  notes       String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  createdById String?

  company  Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  creator  User?               @relation(fields: [createdById], references: [id])
  items    PurchaseOrderItem[]

  @@unique([companyId, poNumber], map: "uq_PurchaseOrder_company_number")
  @@index([companyId, status], map: "idx_PurchaseOrder_company_status")
  @@index([companyId, supplierId], map: "idx_PurchaseOrder_company_supplier")
  @@index([supplierId], map: "idx_PurchaseOrder_supplierId")
  @@index([createdById], map: "idx_PurchaseOrder_createdById")
  @@index([companyId, status, createdAt], map: "idx_PurchaseOrder_company_status_created")
  @@map("PurchaseOrder")
}

model PurchaseOrderItem {
  id               String  @id @default(cuid())
  purchaseOrderId  String
  productVariantId String?
  materialId       String?
  quantity         Int     @default(1)
  unitCost         Decimal
  totalCost        Decimal
  receivedQty      Int     @default(0)

  purchaseOrder PurchaseOrder   @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [productVariantId], references: [id])
  material      Material?       @relation(fields: [materialId], references: [id])

  @@index([purchaseOrderId], map: "idx_PurchaseOrderItem_purchaseOrderId")
  @@index([productVariantId], map: "idx_PurchaseOrderItem_productVariantId")
  @@index([materialId], map: "idx_PurchaseOrderItem_materialId")
  @@map("PurchaseOrderItem")
}

// ──────────────────────────────────────────────
// Finance — Payments & Invoices (with corrected cascade rules)
// ──────────────────────────────────────────────

model Payment {
  id            String        @id @default(cuid())
  orderId       String        @unique
  companyId     String
  clientId      String
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  amount        Decimal
  currency      String        @default("ARS")
  transactionId String?
  reference     String?
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime      @default(now())

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company  @relation(fields: [companyId], references: [id])
  client  Customer @relation(fields: [clientId], references: [id])
  invoice Invoice?

  @@index([companyId, clientId], map: "idx_Payment_company_client")
  @@index([companyId, status], map: "idx_Payment_company_status")
  @@index([clientId], map: "idx_Payment_clientId")
  @@map("Payment")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber String
  companyId     String
  clientId      String
  orderId       String?       @unique
  paymentId     String?       @unique
  addressId     String?
  issueDate     DateTime
  dueDate       DateTime?
  status        InvoiceStatus @default(DRAFT)
  subtotal      Decimal       @default(0)
  taxRate       Decimal?      @default(0)
  taxAmount     Decimal?      @default(0)
  totalAmount   Decimal       @default(0)
  currency      String        @default("ARS")
  fiscalData    Json?
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  createdById   String?

  company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Customer @relation(fields: [clientId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])
  payment Payment? @relation(fields: [paymentId], references: [id])
  address Address? @relation("InvoiceBillingAddress", fields: [addressId], references: [id])
  creator User?    @relation("InvoiceCreator", fields: [createdById], references: [id])

  @@unique([companyId, invoiceNumber], map: "uq_Invoice_company_number")
  @@index([companyId, status], map: "idx_Invoice_company_status")
  @@index([companyId, clientId], map: "idx_Invoice_company_client")
  @@index([addressId], map: "idx_Invoice_addressId")
  @@index([createdById], map: "idx_Invoice_createdById")
  @@index([fiscalData], type: Gin, map: "idx_Invoice_fiscalData_gin")
  @@map("Invoice")
}

// ──────────────────────────────────────────────
// Shipping
// ──────────────────────────────────────────────

model Shipment {
  id             String         @id @default(cuid())
  orderId        String         @unique
  companyId      String
  addressId      String
  carrier        String?
  trackingNumber String?
  carrierUrl     String?
  status         ShipmentStatus @default(PENDING)
  shippedAt      DateTime?
  deliveredAt    DateTime?
  notes          String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id])
  address Address @relation("ShipmentAddress", fields: [addressId], references: [id])

  @@index([companyId, status], map: "idx_Shipment_company_status")
  @@index([addressId], map: "idx_Shipment_addressId")
  @@map("Shipment")
}

// ──────────────────────────────────────────────
// Notification
// ──────────────────────────────────────────────

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
  orderId String?

  @@index([userId, read, createdAt], map: "idx_Notification_user_read_created")
  @@index([orderId], map: "idx_Notification_orderId")
  @@index([data], type: Gin, map: "idx_Notification_data_gin")
  @@map("Notification")
}

// ──────────────────────────────────────────────
// Uploaded Files — now with companyId for proper multitenancy isolation
// ──────────────────────────────────────────────

model UploadedFile {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  originalName  String
  mimeType      String
  size          Int
  url           String
  thumbnailUrl  String?
  fileType      FileType @default(OTHER)
  uploadedById  String?
  uploadedForId String?
  uploadedFor   String?
  metadata      Json?
  createdAt     DateTime @default(now())

  uploader User?    @relation(fields: [uploadedById], references: [id])
  product  Product? @relation(fields: [uploadedForId], references: [id])
  company  Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, uploadedById], map: "idx_UploadedFile_company_uploader")
  @@index([uploadedById], map: "idx_UploadedFile_uploadedById")
  @@index([uploadedForId], map: "idx_UploadedFile_uploadedForId")
  @@index([metadata], type: Gin, map: "idx_UploadedFile_metadata_gin")
  @@map("UploadedFile")
}

// ──────────────────────────────────────────────
// Audit Log — now with companyId for tenant isolation
// ──────────────────────────────────────────────

model AuditLog {
  id         String    @id @default(cuid())
  companyId  String
  action     String
  entityType String
  entityId   String?
  actorId    String?
  actorRole  UserRole?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id])
  actor   User?   @relation("AuditActor", fields: [actorId], references: [id])
  order   Order?  @relation("OrderAudit", fields: [entityId], references: [id])

  @@index([companyId, createdAt], map: "idx_AuditLog_company_createdAt")
  @@index([companyId, entityType, entityId], map: "idx_AuditLog_company_entity")
  @@index([companyId, actorId], map: "idx_AuditLog_company_actor")
  @@index([entityId], map: "idx_AuditLog_entityId")
  @@index([actorId], map: "idx_AuditLog_actorId")
  @@index([metadata], type: Gin, map: "idx_AuditLog_metadata_gin")
  @@map("AuditLog")
}

// ──────────────────────────────────────────────
// System & Company Configuration
// ──────────────────────────────────────────────

model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique(map: "uq_SystemConfig_key")
  value       Json
  label       String?
  description String?
  category    String?
  updatedAt   DateTime @updatedAt

  @@map("SystemConfig")
}

model CompanySetting {
  id          String  @id @default(cuid())
  companyId   String
  key         String
  value       Json
  label       String?
  description String?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key], map: "uq_CompanySetting_company_key")
  @@map("CompanySetting")
}
